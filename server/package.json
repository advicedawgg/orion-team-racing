    "selftest": "node selftest.js",
    "bundle-client": "node ../tools/build-geckos.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@geckos.io/server": "3.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@geckos.io/client": "3.1.0",
    "esbuild": "^0.28.2"
  }
}
